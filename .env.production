# ── Production .env ─────────────────────────────────────────────────────────
# Copy to .env on the EC2 server before deploying.

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PHONE=50767815352

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Waha (WhatsApp gateway) ──────────────────────────────────────────────────
WAHA_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=CHANGE_ME_STRONG_KEY
WAHA_BOT_PHONE=50766xxxxxx

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://schoolbot:CHANGE_ME_DB_PASSWORD@postgres:5432/schoolbot
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ── Scheduler ────────────────────────────────────────────────────────────────
TIMEZONE=America/Panama
SYNC_TIME=18:20
SUMMARY_DAY=thursday
SUMMARY_TIME=18:30
REMINDER_TIME=07:00
