# ── Local development ──────────────
:5005 {
    # Route admin API requests to the FastAPI backend
    handle /api/admin* {
        reverse_proxy schoolbot:8000
    }

    # Route everything else to the Next.js app
    handle {
        reverse_proxy admin-panel:3000
    }
}

localhost {
    # All other requests (webhooks, health, etc.) go to schoolbot
    handle {
        reverse_proxy schoolbot:8000
    }
}
